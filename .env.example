# Copy to .env (which is git-ignored). Real environment variables override this file.
DLP_ENV=production
DB_PATH=/var/data/dlp.db
# Required on first production start; creates the admin account, which must change it at first sign-in.
# 10+ characters with letters and digits. Remove it from the environment after the first start.
DLP_INITIAL_ADMIN_PASSWORD=REPLACE_ME
# Optional; otherwise generated and stored next to the database (/var/data/dlp.db.secret)
# SECRET_KEY=
